{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeliveryGuard Requirement",
  "type": "object",
  "required": [
    "id",
    "type",
    "title",
    "status",
    "source"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(FR|BR|NFR|ERR)-[0-9]{3,}$"
    },
    "type": {
      "enum": [
        "functional",
        "business_rule",
        "non_functional",
        "error"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "proposed",
        "approved",
        "deprecated"
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "kind",
        "reference"
      ],
      "properties": {
        "kind": {
          "enum": [
            "customer_confirmed",
            "contract",
            "code_observed",
            "inferred",
            "unknown"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "code_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "test_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "owner": {
      "type": "string"
    },
    "last_reviewed_commit": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
